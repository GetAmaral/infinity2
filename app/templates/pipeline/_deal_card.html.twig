{% set aiScoreClass = deal.isHotDeal ? 'hot' : (deal.isAtRisk ? 'risk' : (deal.aiScore >= 60 ? 'healthy' : 'cold')) %}
{% set chatTalk = deal.chatTalk %}

<div class="deal-card deal-card--{{ aiScoreClass }}"
     data-pipeline-board-target="card"
     data-deal-id="{{ deal.id }}"
     data-ai-score="{{ deal.aiScore ?? 0 }}"
     data-amount="{{ deal.expectedAmount ?? 0 }}"
     data-days-stale="{{ deal.daysStale ?? 0 }}"
     data-owner-id="{{ deal.owner ? deal.owner.id : '' }}"
     data-action="click->deal-detail#open">

    {# Header: Title + Amount #}
    <div class="deal-card__header">
        {% if deal.aiScore %}
        <div class="deal-card__ai-score deal-card__ai-score--{{ aiScoreClass }}">{{ deal.aiScore }}</div>
        {% endif %}
        <div class="deal-card__title">
            <h4>{{ deal.name }}</h4>
            <span class="deal-card__amount">${{ (deal.expectedAmount ?? 0)|number_format(0) }}</span>
        </div>
    </div>

    {# Contact & Company #}
    <div class="deal-card__contact">
        {% if deal.primaryContact %}
        <span class="contact-name"><i class="bi bi-person-fill"></i> {{ deal.primaryContact.name }}</span>
        {% endif %}
        {% if deal.company %}
        <span class="company-name"><i class="bi bi-building"></i> {{ deal.company.name }}</span>
        {% endif %}
    </div>

    {# Last Message Preview #}
    {% if chatTalk and chatTalk.lastMessagePreview %}
    <div class="deal-card__message">
        <span class="message-date">{{ chatTalk.dateLastMessage ? chatTalk.dateLastMessage|date('d/m H:i') : '' }}</span>
        <span class="message-preview">{{ chatTalk.lastMessagePreview|length > 40 ? chatTalk.lastMessagePreview|slice(0, 40) ~ '...' : chatTalk.lastMessagePreview }}</span>
    </div>
    {% endif %}

    {# Meta Information - Compact #}
    <div class="deal-card__meta">
        <span class="meta-item"><i class="bi bi-person-badge"></i> {{ deal.owner ? deal.owner.name|split(' ')[0] : ('pipeline.card.unassigned'|trans) }}</span>
        {% if deal.expectedClosureDate %}<span class="meta-item"><i class="bi bi-calendar"></i> {{ deal.expectedClosureDate|date('d/m') }}</span>{% endif %}
        {% if deal.daysInCurrentStage %}<span class="meta-item"><i class="bi bi-clock"></i> {{ deal.daysInCurrentStage|round }}d</span>{% endif %}
    </div>

    {# Quick Actions (Show on hover) #}
    <div class="deal-card__actions">
        {% if chatTalk %}
        <a href="{{ path('chat_talk', {id: chatTalk.id}) }}" class="deal-card__action-btn" title="{{ 'pipeline.card.chat'|trans }}" data-action="click->pipeline-board#stopPropagation"><i class="bi bi-chat-dots-fill"></i></a>
        {% else %}
        <a href="{{ path('chat_new_from_deal', {id: deal.id}) }}" class="deal-card__action-btn deal-card__action-btn--new" title="{{ 'pipeline.card.new_chat'|trans }}" data-action="click->pipeline-board#stopPropagation"><i class="bi bi-chat-dots"></i></a>
        {% endif %}
        <button type="button"
                data-controller="modal-opener"
                data-modal-opener-url-value="{{ path('deal_edit', {id: deal.id, modal: 1}) }}"
                data-action="click->modal-opener#open click->pipeline-board#stopPropagation"
                title="{{ 'pipeline.card.edit'|trans }}"><i class="bi bi-pencil"></i></button>
        <button type="button" data-action="click->pipeline-board#scoreDeal click->pipeline-board#stopPropagation" data-deal-id="{{ deal.id }}" title="{{ 'pipeline.card.analyze'|trans }}"><i class="bi bi-lightning"></i></button>
    </div>
</div>
