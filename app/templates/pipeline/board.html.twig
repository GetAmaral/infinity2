{% extends 'base.html.twig' %}

{% block title %}{{ pipeline.name }} - {{ 'pipeline.board.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Pipeline Kanban Board - Compact Design with Theme Support */
        .pipeline-board { display: flex; flex-direction: column; height: calc(100vh - 60px); background: var(--luminai-dark-surface, #F1F3F5); overflow: hidden; }
        .pipeline-header { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: var(--luminai-card-bg, #fff); border-bottom: 1px solid var(--luminai-border, #DEE2E6); gap: 12px; flex-wrap: wrap; }
        .pipeline-header__title { font-size: 14px; font-weight: 600; color: var(--luminai-text, #212529); margin: 0; display: flex; align-items: center; gap: 6px; }
        .pipeline-header__title i { font-size: 14px; color: var(--luminai-primary, #6D28D9); }
        .pipeline-header__metrics { display: flex; gap: 16px; font-size: 11px; }
        .metric { display: flex; align-items: center; gap: 4px; }
        .metric__label { color: var(--luminai-text-muted, #868E96); font-weight: 500; }
        .metric__value { font-size: 12px; font-weight: 700; color: var(--luminai-text, #212529); }
        .metric__value--positive { color: #37B24D; }
        .pipeline-header__actions .btn { padding: 4px 10px; font-size: 12px; }
        .pipeline-columns { display: flex; gap: 8px; padding: 8px; overflow-x: auto; flex: 1; }
        .stage-column { flex: 0 0 240px; min-width: 240px; max-width: 240px; display: flex; flex-direction: column; background: var(--luminai-card-bg, #fff); border-radius: 6px; box-shadow: 0 1px 2px var(--luminai-shadow, rgba(0,0,0,0.06)); }
        .stage-column.drop-zone--active { box-shadow: 0 0 0 2px #37B24D; }
        .stage-column__header { padding: 8px 10px; border-bottom: 2px solid; background: var(--luminai-hover-bg, #FAFAFA); }
        .stage-column__header__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
        .stage-column__header__name { font-size: 11px; font-weight: 700; color: var(--luminai-text, #495057); text-transform: uppercase; letter-spacing: 0.3px; }
        .stage-column__header__count { font-size: 11px; font-weight: 600; color: var(--luminai-text-muted, #868E96); padding: 1px 6px; background: var(--luminai-border, #E9ECEF); border-radius: 8px; }
        .stage-column__header__metrics { display: flex; justify-content: space-between; }
        .stage-column__header__metrics .metric { flex-direction: column; align-items: flex-start; gap: 0; }
        .stage-column__header__metrics .metric__label { font-size: 9px; color: var(--luminai-text-muted, #ADB5BD); }
        .stage-column__header__metrics .metric__value { font-size: 11px; font-weight: 600; color: var(--luminai-text, #212529); }
        .stage-column__cards { flex: 1; padding: 6px; overflow-y: auto; min-height: 100px; }
        .stage-column__cards::-webkit-scrollbar { width: 4px; }
        .stage-column__cards::-webkit-scrollbar-thumb { background: var(--luminai-border, #DEE2E6); border-radius: 2px; }

        /* Compact Deal Cards */
        .deal-card { background: var(--luminai-card-bg, #fff); border-radius: 4px; padding: 8px; margin-bottom: 6px; box-shadow: 0 1px 2px var(--luminai-shadow, rgba(0,0,0,0.05)); border-left: 3px solid transparent; cursor: pointer; transition: all 0.15s; position: relative; }
        .deal-card:hover { box-shadow: 0 2px 6px var(--luminai-shadow, rgba(0,0,0,0.1)); background: var(--luminai-hover-bg, #f8f9fa); }
        .deal-card--hot { border-left-color: #F03E3E; }
        .deal-card--healthy { border-left-color: #37B24D; }
        .deal-card--risk { border-left-color: #F59F00; }
        .deal-card--cold { border-left-color: #4C6EF5; }
        .deal-card__header { display: flex; align-items: flex-start; gap: 6px; margin-bottom: 4px; }
        .deal-card__ai-score { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; font-weight: 700; font-size: 10px; flex-shrink: 0; color: white; margin-top: 2px; }
        .deal-card__ai-score--hot { background: #F03E3E; }
        .deal-card__ai-score--healthy { background: #37B24D; }
        .deal-card__ai-score--risk { background: #F59F00; }
        .deal-card__ai-score--cold { background: #4C6EF5; }
        .deal-card__title { flex: 1; min-width: 0; }
        .deal-card__title h4 { font-size: 12px; font-weight: 600; color: var(--luminai-text, #212529); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3; }
        .deal-card__title .deal-card__amount { font-size: 13px; font-weight: 700; color: var(--luminai-text, #212529); display: block; }
        .deal-card__contact { display: flex; flex-direction: column; gap: 2px; margin-bottom: 6px; font-size: 10px; }
        .deal-card__contact .contact-name { color: var(--luminai-text, #495057); font-weight: 500; display: flex; align-items: center; gap: 3px; }
        .deal-card__contact .company-name { color: var(--luminai-text-muted, #868E96); display: flex; align-items: center; gap: 3px; }
        .deal-card__contact i { font-size: 9px; opacity: 0.7; }
        .deal-card__message { background: var(--luminai-hover-bg, #f8f9fa); border-radius: 3px; padding: 4px 6px; margin-bottom: 6px; font-size: 10px; }
        .deal-card__message .message-date { color: var(--luminai-text-muted, #868E96); font-size: 9px; display: block; margin-bottom: 2px; }
        .deal-card__message .message-preview { color: var(--luminai-text-secondary, #495057); line-height: 1.3; display: block; }
        .deal-card__meta { display: flex; align-items: center; gap: 8px; font-size: 10px; color: var(--luminai-text-muted, #868E96); flex-wrap: wrap; }
        .deal-card__meta .meta-item { display: flex; align-items: center; gap: 2px; }
        .deal-card__meta .meta-item i { font-size: 9px; }
        .deal-card__actions { position: absolute; top: 4px; right: 4px; display: flex; gap: 2px; opacity: 0; transition: opacity 0.15s; }
        .deal-card:hover .deal-card__actions { opacity: 1; }
        .deal-card__actions button, .deal-card__actions .deal-card__action-btn { width: 20px; height: 20px; border-radius: 3px; border: none; background: var(--luminai-hover-bg, #F8F9FA); color: var(--luminai-text-muted, #495057); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 10px; text-decoration: none; }
        .deal-card__actions button:hover, .deal-card__actions .deal-card__action-btn:hover { background: var(--luminai-border, #E9ECEF); }
        .deal-card__actions .deal-card__action-btn { color: #37B24D; }
        .deal-card__actions .deal-card__action-btn--new { color: var(--luminai-text-muted, #868E96); }

        /* Detail Panel */
        .deal-detail-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--luminai-overlay-bg, rgba(0,0,0,0.4)); z-index: 1000; }
        .deal-detail-overlay.show { display: flex; align-items: center; justify-content: flex-end; }
        .deal-detail-panel { width: 480px; height: 100%; background: var(--luminai-card-bg, #fff); box-shadow: -2px 0 8px var(--luminai-shadow, rgba(0,0,0,0.1)); transform: translateX(100%); transition: transform 0.2s; overflow-y: auto; }
        .deal-detail-panel.show { transform: translateX(0); }

        /* Empty State */
        .stage-empty { font-size: 11px; padding: 16px 8px; text-align: center; color: var(--luminai-text-muted, #868E96); }
        .stage-empty i { font-size: 20px; opacity: 0.5; }
        .stage-empty p { margin-top: 4px; }

        @media (max-width: 768px) {
            .stage-column { flex: 0 0 200px; min-width: 200px; max-width: 200px; }
            .pipeline-header { padding: 6px 8px; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="pipeline-board"
     data-controller="pipeline-board"
     data-pipeline-board-pipeline-id-value="{{ pipeline.id }}"
     data-pipeline-board-refresh-interval-value="30000">

    {# Pipeline Header #}
    <div class="pipeline-header" data-pipeline-board-target="metrics">
        <div class="pipeline-header__title">
            <i class="bi bi-{{ pipeline.icon ?? 'diagram-3' }}"></i>
            <span>{{ pipeline.name }}</span>
        </div>

        <div class="pipeline-header__metrics">
            <div class="metric">
                <span class="metric__label">{{ 'pipeline.metrics.total_value'|trans }}</span>
                <span class="metric__value" data-value>
                    {{ '$%s'|format((metrics.totalPipelineValue ?? 0)|number_format(0)) }}
                </span>
            </div>
            <div class="metric">
                <span class="metric__label">{{ 'pipeline.metrics.forecast'|trans }}</span>
                <span class="metric__value metric__value--positive" data-value>
                    {{ '$%s'|format((metrics.forecastedRevenue ?? 0)|number_format(0)) }}
                </span>
            </div>
            <div class="metric">
                <span class="metric__label">{{ 'pipeline.metrics.deals'|trans }}</span>
                <span class="metric__value" data-value>
                    {{ metrics.activeDealsCount ?? 0 }}
                </span>
            </div>
            <div class="metric">
                <span class="metric__label">{{ 'pipeline.metrics.avg_cycle'|trans }}</span>
                <span class="metric__value">
                    {{ 'pipeline.metrics.days'|trans({'%count%': metrics.avgCycleTime ?? 0}) }}
                </span>
            </div>
        </div>

        <div class="pipeline-header__actions">
            <button type="button"
                    class="btn btn-primary"
                    data-controller="modal-opener"
                    data-action="click->modal-opener#open"
                    data-modal-opener-url-value="{{ path('deal_new', {modal: 1}) }}">
                <i class="bi bi-plus-lg"></i> {{ 'pipeline.actions.new_deal'|trans }}
            </button>
        </div>
    </div>

    {# Stage Columns #}
    <div class="pipeline-columns">
        {% set stages = pipeline.stages|sort((a, b) => a.displayOrder <=> b.displayOrder) %}
        {% for stage in stages %}
            {% set stageDeals = stage.deals|filter(d => d.dealStatus in ['open', 'in_progress']) %}
            {% set stageValue = stageDeals|reduce((sum, d) => sum + (d.expectedAmount ?? 0), 0) %}
            {% set avgDays = stageDeals|length > 0 ? (stageDeals|reduce((sum, d) => sum + (d.daysInCurrentStage ?? 0), 0) / stageDeals|length) : 0 %}

            <div class="stage-column"
                 data-pipeline-board-target="column"
                 data-stage-id="{{ stage.id }}">

                <div class="stage-column__header" style="color: {{ stage.color ?? '#228BE6' }};">
                    <div class="stage-column__header__top">
                        <h3 class="stage-column__header__name">{{ stage.name }}</h3>
                        <span class="stage-column__header__count" data-count>
                            {{ stageDeals|length }}
                        </span>
                    </div>

                    <div class="stage-column__header__metrics">
                        <div class="metric">
                            <span class="metric__label">{{ 'pipeline.stage.value'|trans }}</span>
                            <span class="metric__value" data-value>
                                ${{ stageValue|number_format(0) }}
                            </span>
                        </div>
                        <div class="metric">
                            <span class="metric__label">{{ 'pipeline.stage.avg_days'|trans }}</span>
                            <span class="metric__value">
                                {{ avgDays|round }}
                            </span>
                        </div>
                    </div>
                </div>

                <div class="stage-column__cards" data-cards>
                    {% for deal in stageDeals %}
                        {{ include('pipeline/_deal_card.html.twig', {deal: deal}) }}
                    {% endfor %}

                    {% if stageDeals|length == 0 %}
                        <div class="stage-empty">
                            <i class="bi bi-inbox"></i>
                            <p>{{ 'pipeline.stage.empty'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{# Deal Detail Panel #}
<div class="deal-detail-overlay"
     data-controller="deal-detail"
     data-deal-detail-target="overlay"
     data-action="click->deal-detail#handleOverlayClick">

    <div class="deal-detail-panel"
         data-deal-detail-target="panel">
        <div data-deal-detail-target="content">
            {# Content loaded dynamically #}
        </div>
    </div>
</div>
{% endblock %}
